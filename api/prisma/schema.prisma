generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SOCIO
  COLABORADOR_EXTERNO
  JUNTA_DIRECTIVA
  ADMINISTRADOR
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(SOCIO)
  active              Boolean              @default(true)
  studies             String?
  photoUrl            String?
  position            Position?
  leaveRequests       LeaveRequest[]
  trainingsTaught     Training[]           @relation("TrainingInstructor")
  trainingEnrollments TrainingEnrollment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model Position {
  id        String   @id @default(uuid())
  name      String   @unique
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("positions")
}

enum MembershipRequestStatus {
  PENDING
  APPROVED
}

model MembershipRequest {
  id           String                  @id @default(uuid())
  name         String
  email        String
  motivation   String
  isUpoStudent Boolean
  status       MembershipRequestStatus @default(PENDING)
  createdAt    DateTime                @default(now())

  @@map("membership_requests")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
}

model LeaveRequest {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  status    LeaveRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())

  @@map("leave_requests")
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String
  place         String
  date          DateTime
  content       String   @default("")
  coverImageUrl String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("events")
}

model Training {
  id           String               @id @default(uuid())
  title        String
  description  String
  place        String
  date         DateTime
  instructorId String
  instructor   User                 @relation("TrainingInstructor", fields: [instructorId], references: [id])
  published    Boolean              @default(false)
  enrollments  TrainingEnrollment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("trainings")
}

model TrainingEnrollment {
  id         String   @id @default(uuid())
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([trainingId, userId])
  @@map("training_enrollments")
}
